###############################################################################
# Clock input 100 MHz
###############################################################################
NET "clk100" LOC = "E9" | IOSTANDARD = LVCMOS33;
TIMESPEC TS_clk100 = PERIOD "clk100" 10 ns HIGH 50%;

###############################################################################
# Push buttons (BTN0 = reset)
###############################################################################
NET "btn[0]" LOC = "U18" | IOSTANDARD = LVCMOS33;
NET "btn[1]" LOC = "R13" | IOSTANDARD = LVCMOS33;
NET "btn[2]" LOC = "T13" | IOSTANDARD = LVCMOS33;
NET "btn[3]" LOC = "E16" | IOSTANDARD = LVCMOS33;
NET "btn[4]" LOC = "M17" | IOSTANDARD = LVCMOS33;

###############################################################################
# Slide switches SW0–SW7
###############################################################################
NET "sw[0]" LOC = "J15" | IOSTANDARD = LVCMOS33;
NET "sw[1]" LOC = "L16" | IOSTANDARD = LVCMOS33;
NET "sw[2]" LOC = "M13" | IOSTANDARD = LVCMOS33;
NET "sw[3]" LOC = "R15" | IOSTANDARD = LVCMOS33;
NET "sw[4]" LOC = "R17" | IOSTANDARD = LVCMOS33;
NET "sw[5]" LOC = "T18" | IOSTANDARD = LVCMOS33;
NET "sw[6]" LOC = "U18" | IOSTANDARD = LVCMOS33;
NET "sw[7]" LOC = "V16" | IOSTANDARD = LVCMOS33;

###############################################################################
# LEDs LD0–LD7
###############################################################################
NET "led[0]" LOC = "U16" | IOSTANDARD = LVCMOS33;
NET "led[1]" LOC = "E17" | IOSTANDARD = LVCMOS33;
NET "led[2]" LOC = "K14" | IOSTANDARD = LVCMOS33;
NET "led[3]" LOC = "K15" | IOSTANDARD = LVCMOS33;
NET "led[4]" LOC = "J13" | IOSTANDARD = LVCMOS33;
NET "led[5]" LOC = "T9"  | IOSTANDARD = LVCMOS33;
NET "led[6]" LOC = "T10" | IOSTANDARD = LVCMOS33;
NET "led[7]" LOC = "T11" | IOSTANDARD = LVCMOS33;
